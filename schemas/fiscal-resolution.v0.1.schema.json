{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:avilaops:fiscal-resolution:0.1",
  "title": "Resolução declarada para planejamento de simulação fiscal",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "inputFingerprint", "ruleSnapshot", "lines"],
  "properties": {
    "schemaVersion": { "const": "0.1" },
    "inputFingerprint": { "$ref": "#/$defs/hash" },
    "ruleSnapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "sha256"],
      "properties": {
        "id": { "$ref": "#/$defs/reference" },
        "version": { "$ref": "#/$defs/reference" },
        "sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "lines": {
      "type": "array", "minItems": 1, "maxItems": 10000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["lineId", "classification", "taxes"],
        "properties": {
          "lineId": { "$ref": "#/$defs/reference" },
          "classification": {
            "type": "object", "additionalProperties": false,
            "required": ["status", "evidenceRef"],
            "properties": {
              "status": { "enum": ["matched", "rejected", "undetermined"] },
              "evidenceRef": { "$ref": "#/$defs/reference" }
            }
          },
          "taxes": {
            "type": "object", "additionalProperties": false,
            "required": ["icmsOwn", "icmsSt", "difal"],
            "properties": {
              "icmsOwn": { "$ref": "#/$defs/assessment" },
              "icmsSt": { "$ref": "#/$defs/assessment" },
              "difal": { "$ref": "#/$defs/assessment" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "reference": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$" },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "assessment": {
      "type": "object", "additionalProperties": false,
      "required": ["applicability", "ruleRef", "reason"],
      "properties": {
        "applicability": { "enum": ["applicable", "not_applicable", "undetermined"] },
        "ruleRef": { "$ref": "#/$defs/reference" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 1000, "pattern": "\\S" }
      }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:avilaops:fiscal-input:0.1",
  "title": "Proposta de entrada para simulação de venda doméstica de mercadorias",
  "description": "Contrato experimental de contexto, sem cálculo ou autorização fiscal. Valores declarados precisam ser conferidos pelo executor.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mode", "requestId", "tenantId", "operation", "seller", "buyer", "items", "ruleSnapshot"],
  "properties": {
    "schemaVersion": { "const": "0.1" },
    "mode": { "const": "simulation" },
    "requestId": { "$ref": "#/$defs/id" },
    "tenantId": { "$ref": "#/$defs/id" },
    "operation": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "documentModel", "date", "currency", "shipFromUf", "shipToUf", "finalConsumer"],
      "properties": {
        "kind": { "const": "domestic_goods_sale" },
        "documentModel": { "const": "55" },
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "currency": { "const": "BRL" },
        "shipFromUf": { "$ref": "#/$defs/uf" },
        "shipToUf": { "$ref": "#/$defs/uf" },
        "finalConsumer": { "type": ["boolean", "null"] }
      }
    },
    "seller": { "$ref": "#/$defs/party" },
    "buyer": { "$ref": "#/$defs/party" },
    "items": {
      "type": "array", "minItems": 1, "maxItems": 10000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["lineId", "sku", "description", "classificationSnapshotRef", "ncm", "cest", "originCode", "cfop", "unit", "quantity", "unitPrice", "freight", "insurance", "discount", "otherCharges"],
        "properties": {
          "lineId": { "$ref": "#/$defs/id" },
          "sku": { "$ref": "#/$defs/id" },
          "description": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "\\S" },
          "classificationSnapshotRef": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
          "ncm": { "type": ["string", "null"], "pattern": "^[0-9]{8}$" },
          "cest": { "type": ["string", "null"], "pattern": "^[0-9]{7}$", "description": "Null representa dado não informado; não significa isenção nem não aplicação de ST." },
          "originCode": { "type": ["string", "null"], "pattern": "^[0-9]$" },
          "cfop": { "type": ["string", "null"], "pattern": "^[0-9]{4}$" },
          "unit": { "$ref": "#/$defs/id" },
          "quantity": { "$ref": "#/$defs/decimal" },
          "unitPrice": { "$ref": "#/$defs/decimal" },
          "freight": { "$ref": "#/$defs/money" },
          "insurance": { "$ref": "#/$defs/money" },
          "discount": { "$ref": "#/$defs/money" },
          "otherCharges": { "$ref": "#/$defs/money" }
        }
      }
    },
    "ruleSnapshot": { "anyOf": [{ "$ref": "#/$defs/snapshot" }, { "type": "null" }] }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$" },
    "uf": { "enum": ["AC", "AL", "AP", "AM", "BA", "CE", "DF", "ES", "GO", "MA", "MT", "MS", "MG", "PA", "PB", "PR", "PE", "PI", "RJ", "RN", "RS", "RO", "RR", "SC", "SP", "SE", "TO"] },
    "decimal": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,17})(\\.[0-9]{1,6})?$", "description": "Decimal não negativo em texto, até seis casas; escala de transporte do piloto, não regra fiscal de arredondamento." },
    "money": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,17})\\.[0-9]{2}$" },
    "party": {
      "type": "object", "additionalProperties": false,
      "required": ["partyRef", "establishmentUf", "taxProfileSnapshotRef", "icmsContributor", "taxRegime"],
      "properties": {
        "partyRef": { "$ref": "#/$defs/id" },
        "establishmentUf": { "$ref": "#/$defs/uf" },
        "taxProfileSnapshotRef": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "icmsContributor": { "enum": ["contributor", "non_contributor", "exempt_registration", "unknown"] },
        "taxRegime": { "enum": ["normal", "simples_nacional", "mei", "unknown"] }
      }
    },
    "snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "sha256"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/id" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}

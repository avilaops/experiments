{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://erp.avilaops.com/schemas/product-flow-definitions-1.json",
  "title": "Definições de funcionalidades do ERP",
  "description": "Metadados de produto que referenciam as ações canônicas de verification/contracts.json. Não declaram execução nem publicação.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "product",
    "flows"
  ],
  "properties": {
    "schemaVersion": {
      "const": "erp-product-flow-definitions/1"
    },
    "product": {
      "const": "erp"
    },
    "flows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/flow"
      }
    }
  },
  "$defs": {
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "goal",
        "kind",
        "actionGroups",
        "dependencies",
        "nextStep"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$",
          "maxLength": 100
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "kind": {
          "enum": [
            "product",
            "support"
          ]
        },
        "actionGroups": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$",
            "maxLength": 100
          },
          "uniqueItems": true,
          "maxItems": 100,
          "minItems": 1
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$",
            "maxLength": 100
          },
          "uniqueItems": true,
          "maxItems": 100
        },
        "nextStep": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "additionalSources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "uniqueItems": true,
          "maxItems": 200
        },
        "journey": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/step"
          }
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "actionIds",
        "authRefs",
        "externalSystems"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$",
          "maxLength": 100
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "actionIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$",
            "maxLength": 100
          },
          "uniqueItems": true,
          "maxItems": 100
        },
        "authRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "uniqueItems": true,
          "maxItems": 200
        },
        "externalSystems": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "uniqueItems": true,
          "maxItems": 200
        }
      }
    }
  }
}

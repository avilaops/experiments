{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ml.avilaops.com/schemas/evaluation-request-v1.json",
  "title": "Solicitação de avaliação do Ávila MLOps",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "project", "revision", "suite", "environment", "trigger", "requestedAt", "requestedBy"],
  "properties": {
    "schemaVersion": { "const": "evaluation-request/1" },
    "requestId": { "$ref": "#/$defs/id" },
    "project": { "$ref": "#/$defs/project" },
    "revision": { "$ref": "#/$defs/revision" },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/version" }
      }
    },
    "environment": { "enum": ["local_isolated", "staging", "production"] },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["pull_request", "push", "workflow_dispatch", "manual", "webhook"] },
        "externalId": { "$ref": "#/$defs/shortText" }
      }
    },
    "requestedAt": { "$ref": "#/$defs/dateTime" },
    "requestedBy": { "$ref": "#/$defs/actor" },
    "callback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["github_check", "webhook", "none"] },
        "reference": { "$ref": "#/$defs/shortText" }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$" },
    "version": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$" },
    "shortText": { "type": "string", "minLength": 1, "maxLength": 1000, "pattern": "\\S" },
    "dateTime": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?(?:Z|[+-][0-9]{2}:[0-9]{2})$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "enum": ["github_action", "agent", "human", "system"] },
        "id": { "$ref": "#/$defs/id" }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "repository", "product"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "product": { "$ref": "#/$defs/id" }
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "sourceFingerprint"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
        "sourceFingerprint": { "$ref": "#/$defs/sha256" },
        "branch": { "$ref": "#/$defs/shortText" },
        "pullRequestNumber": { "type": ["integer", "null"], "minimum": 1 }
      }
    }
  }
}

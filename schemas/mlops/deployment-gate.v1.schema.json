{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ml.avilaops.com/schemas/deployment-gate-v1.json",
  "title": "Gate de publicação do Ávila MLOps",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "gateId", "requestId", "project", "revision", "target", "policyDecisionId", "status", "allowed", "createdAt", "checks"],
  "properties": {
    "schemaVersion": { "const": "deployment-gate/1" },
    "gateId": { "$ref": "#/$defs/id" },
    "requestId": { "$ref": "#/$defs/id" },
    "project": { "$ref": "#/$defs/project" },
    "revision": { "$ref": "#/$defs/revision" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["application", "environment"],
      "properties": {
        "application": { "$ref": "#/$defs/id" },
        "environment": { "enum": ["staging", "production"] }
      }
    },
    "policyDecisionId": { "$ref": "#/$defs/id" },
    "status": { "enum": ["pending", "approved", "blocked", "expired", "consumed"] },
    "allowed": { "type": "boolean" },
    "createdAt": { "$ref": "#/$defs/dateTime" },
    "expiresAt": { "anyOf": [{ "$ref": "#/$defs/dateTime" }, { "type": "null" }] },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "required"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "status": { "enum": ["passed", "failed", "inconclusive", "not_run"] },
          "required": { "type": "boolean" },
          "reason": { "$ref": "#/$defs/shortText" }
        }
      }
    },
    "postDeploy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["healthCheckRequired", "rollbackOnFailure"],
      "properties": {
        "healthCheckRequired": { "type": "boolean" },
        "rollbackOnFailure": { "type": "boolean" },
        "healthCheckReference": { "$ref": "#/$defs/shortText" }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$" },
    "shortText": { "type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S" },
    "dateTime": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?(?:Z|[+-][0-9]{2}:[0-9]{2})$" },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "repository", "product"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "product": { "$ref": "#/$defs/id" }
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "sourceFingerprint"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
        "sourceFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "branch": { "$ref": "#/$defs/shortText" },
        "pullRequestNumber": { "type": ["integer", "null"], "minimum": 1 }
      }
    }
  }
}

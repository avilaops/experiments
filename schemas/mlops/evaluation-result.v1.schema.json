{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ml.avilaops.com/schemas/evaluation-result-v1.json",
  "title": "Resultado de avaliação do Ávila MLOps",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "evaluationId", "requestId", "project", "revision", "suite", "runId", "status", "startedAt", "completedAt", "summary", "checks", "evidenceIds", "assurance", "limitations"],
  "properties": {
    "schemaVersion": { "const": "evaluation-result/1" },
    "evaluationId": { "$ref": "#/$defs/id" },
    "requestId": { "$ref": "#/$defs/id" },
    "project": { "$ref": "#/$defs/project" },
    "revision": { "$ref": "#/$defs/revision" },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/version" }
      }
    },
    "runId": { "$ref": "#/$defs/id" },
    "status": { "enum": ["passed", "failed", "inconclusive", "error", "cancelled"] },
    "startedAt": { "$ref": "#/$defs/dateTime" },
    "completedAt": { "$ref": "#/$defs/dateTime" },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredChecks", "passed", "failed", "inconclusive", "error", "notRun", "passRate"],
      "properties": {
        "requiredChecks": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "inconclusive": { "type": "integer", "minimum": 0 },
        "error": { "type": "integer", "minimum": 0 },
        "notRun": { "type": "integer", "minimum": 0 },
        "passRate": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "dimension", "criterion", "required", "method", "status", "artifactSha256"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "dimension": { "enum": ["interface", "request", "authorization", "domain", "persistence", "effects", "failure", "response", "quality", "cost", "latency"] },
          "criterion": { "$ref": "#/$defs/shortText" },
          "required": { "type": "boolean" },
          "method": { "enum": ["static_analysis", "runtime_assertion", "model_suggestion", "trace_assertion", "manual_review"] },
          "status": { "enum": ["passed", "failed", "inconclusive", "error", "not_run"] },
          "score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "artifactSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
          "reason": { "$ref": "#/$defs/shortText" }
        }
      }
    },
    "evidenceIds": {
      "type": "array",
      "items": { "$ref": "#/$defs/id" },
      "uniqueItems": true,
      "maxItems": 10000
    },
    "assurance": { "enum": ["incomplete", "includes_static_checks", "runtime_asserted", "human_reviewed"] },
    "limitations": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/shortText" }
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$" },
    "version": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$" },
    "shortText": { "type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S" },
    "dateTime": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?(?:Z|[+-][0-9]{2}:[0-9]{2})$" },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "repository", "product"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "product": { "$ref": "#/$defs/id" }
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "sourceFingerprint"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" },
        "sourceFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "branch": { "$ref": "#/$defs/shortText" },
        "pullRequestNumber": { "type": ["integer", "null"], "minimum": 1 }
      }
    }
  }
}

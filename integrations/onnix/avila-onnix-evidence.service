[Unit]
Description=Ávila ONNIX evidence collection for Experiments
Wants=avila-upscale-cpu.service
After=avila-upscale-cpu.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/avila-upscale.env
Environment=ONNIX_EVIDENCE_DIR=/var/lib/docker/volumes/avila-experiments_evidence/_data/onnix
ExecStart=/opt/avila-ml/upscale-cpu/venv/bin/python /opt/avila-ml/upscale-cpu/collect_experiment.py
TimeoutStartSec=100
MemoryMax=450M
CPUQuota=75%
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/docker/volumes/avila-experiments_evidence/_data/onnix
UMask=0027

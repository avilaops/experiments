{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM"], "module": "NodeNext",
    "moduleResolution": "NodeNext", "jsx": "react-jsx", "strict": true,
    "noEmit": true, "skipLibCheck": true, "esModuleInterop": true,
    "types": ["node", "react", "react-dom"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
